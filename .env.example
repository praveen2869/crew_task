# ==============================================================================
# RAG Knowledge Assistant Configuration
# ==============================================================================

# OpenAI API Configuration (LLM generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Jina AI Embeddings Configuration
# Get your key at: https://jina.ai/embeddings/
JINA_API_KEY=""
JINA_EMBEDDING_MODEL="jina-embeddings-v5-omni-small"
JINA_EMBEDDING_DIM=1024

# Qdrant Vector Database Configuration
# - For local disk storage without Docker: leave QDRANT_URL empty or unset
# - For Docker or remote Qdrant: set QDRANT_URL="http://localhost:6333" or "http://qdrant:6333"
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_STORAGE_PATH="./qdrant_storage"
QDRANT_COLLECTION_NAME="knowledge_base"

# RAG Pipeline Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SCORE_THRESHOLD=0.35

# Application Settings
API_HOST="0.0.0.0"
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL="INFO"
ENVIRONMENT="development"
